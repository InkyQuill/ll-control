{
  "name": "llcontrol-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "check:contracts": "node --experimental-strip-types scripts/preset-contract.ts | cargo run --quiet --locked --manifest-path ../Cargo.toml -p llcontrol-ipc --example validate-themes && cargo run --quiet --locked --manifest-path ../Cargo.toml -p llcontrol-ipc --example generate-rpc-contract",
    "check:locales": "node scripts/check-locales.mjs --strict",
    "audit:locales": "node scripts/check-locales.mjs",
    "test:localization": "node --experimental-strip-types --test scripts/localization.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "svelte": "^5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "^3",
    "@sveltejs/kit": "^2",
    "@sveltejs/vite-plugin-svelte": "^6",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.4",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.72.2",
    "vite": "^7"
  }
}
