{
  "identifier": "main",
  "description": "Local settings window may use the bounded daemon bridge",
  "windows": ["main"],
  "permissions": [
    "allow-daemon-call",
    "allow-cooling-preset",
    "allow-cooling-mode-default",
    "allow-import-image",
    "allow-image-editor",
    "allow-capture-screenshot",
    "allow-begin-screenshot",
    "allow-cancel-screenshot",
    "allow-pending-screenshot-cleanup",
    "allow-media-playback-url",
    "allow-media-begin",
    "allow-media-append",
    "allow-media-inspect",
    "allow-media-prepare-inspected",
    "allow-media-start",
    "allow-media-confirm",
    "allow-media-status",
    "allow-media-cancel",
    "allow-media-thumbnail",
    "allow-media-thumbnail-cancel",
    "allow-media-source-start",
    "allow-media-source-status",
    "allow-media-source-cancel",
    "allow-media-source-prepare",
    "allow-screen-record-begin",
    "allow-screen-record-start",
    "allow-screen-record-status",
    "allow-screen-record-snapshot",
    "allow-screen-record-control",
    "allow-screen-record-cancel",
    "allow-screen-record-prepare",
    "allow-screen-record-admit",
    "allow-profile-archive-start",
    "allow-profile-archive-status",
    "allow-profile-archive-cancel",
    "allow-profile-archive-recover",
    "allow-profile-archive-dismiss",
    "allow-group-archive-start",
    "allow-group-windows-prepare",
    "allow-group-archive-status",
    "allow-group-archive-action",
    "allow-desktop-settings-get",
    "allow-desktop-set-language",
    "allow-desktop-settings-save",
    "allow-desktop-exit",
    "allow-system-fonts",
    "allow-system-font-read"
