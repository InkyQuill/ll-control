# Maintainer: Inky <me@inkyquill.net>
pkgname=lconnect-linux
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux client for Lian Li L-Connect 3 hardware (Galahad II LCDV2)"
arch=('x86_64')
url="https://github.com/inky/lconnect-linux"
license=('MIT' 'Apache-2.0')
depends=('hidapi' 'systemd')
makedepends=('rust' 'cargo' 'pkg-config')
optdepends=('udev: hot-plug detection (already present on most systems)')
provides=('lconnect-linux')
conflicts=('lconnect-linux-git')
source=("$pkgname-$pkgver.tar.gz::https://github.com/inky/lconnect-linux/archive/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    # If we vendor deps in the future, do it here.
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    export CARGO_TARGET_DIR="$srcdir/cargo-target"
    cargo build --release \
        --bin lconnectd \
        --bin lconnectctl \
        --bin verify-galahad
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    export CARGO_TARGET_DIR="$srcdir/cargo-target"
    cargo test --release --workspace
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # Binaries
    install -Dm755 "$srcdir/cargo-target/release/lconnectd" \
        "$pkgdir/usr/bin/lconnectd"
    install -Dm755 "$srcdir/cargo-target/release/lconnectctl" \
        "$pkgdir/usr/bin/lconnectctl"
    install -Dm755 "$srcdir/cargo-target/release/verify-galahad" \
        "$pkgdir/usr/bin/verify-galahad"

    # udev rule
    install -Dm644 "packaging/udev/70-lianli-hid.rules" \
        "$pkgdir/usr/lib/udev/rules.d/70-lianli-hid.rules"

    # systemd --user unit (rewritten so ExecStart points at /usr/bin/)
    install -dm755 "$pkgdir/usr/lib/systemd/user"
    sed 's|%h/.local/bin/lconnectd|/usr/bin/lconnectd|' \
        "packaging/systemd/lconnectd.service" \
        > "$pkgdir/usr/lib/systemd/user/lconnectd.service"
    chmod 644 "$pkgdir/usr/lib/systemd/user/lconnectd.service"

    # License
    # TODO: add license files at repo root
    # install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    # install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
