  "narrative": {
    "northStar": "Graphite device workbench",
    "overview": "The user approved the interactive Device Studio prototype on 2026-10-16 (\"Мне нравится. выглядит хорошо.\"). That visual direction is now migrated into the production Svelte/Tauri interface. This document records the implemented production system; the prototype remains provenance for the direction, not the token source.\n\nDark graphite surfaces frame pale text and restrained lilac actions. Device schematics provide visual focus without turning the application into a multicolored gallery. The selected device determines its workspaces; LCD is an optional capability rather than the application shell. Interface evidence and previews do not establish physical hardware acceptance.",
    "keyCharacteristics": [
      "Graphite tonal layers and restrained lilac actions.",
      "Self-hosted Exo 2 headings with system body text.",
      "English default and Russian localization.",
      "Device capability navigation and explicit application of drafts.",
      "Stable local editing panels with visible connection and error states."
    ],
    "rules": [
      {
        "name": "The Preview Color Rule",
        "body": "Editable RGB colors belong to device schematics and content; ordinary navigation keeps the lilac interface accent.",
        "section": "colors"
      },
      {
        "name": "The Capability Rule",
        "body": "Expose editors from the implemented family registry; do not infer support from a device name or use LCD as a universal shell.",
        "section": "components"
      },
      {
        "name": "The Explicit Apply Rule",
        "body": "Distinguish local draft, preview, saved profile and device command; editing a draft must not silently write hardware.",
        "section": "components"
      },
      {
        "name": "Display geometry",
        "body": "GALAHAD II LCDV2 has a square 480×480 LCD. Preview and device glyph share model metadata; preserve square corners and use a circular mask only for explicitly round displays. Do not register unsupported families to demonstrate shapes.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** use the production stylesheet and components as the token and behavior source.",
      "**Do** preserve English and Russian labels, visible keyboard focus and reduced-motion support.",
      "**Do** keep capability navigation under its device and ready-made themes, composition and library equally reachable.",
      "**Do** preserve local drafts and distinguish preview, storage and explicit device application."
    ],
    "donts": [
      "**Don't** present schematic output, fixtures or browser screenshots as physical hardware acceptance.",
      "**Don't** give unknown device families implemented editors or assume every device has an LCD.",
      "**Don't** spread user-selected RGB colors through ordinary navigation and controls.",
      "**Don't** reintroduce prototype-only token values, animations or demo Apply semantics into production documentation."
    ]
  }
}
